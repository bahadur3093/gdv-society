generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  password              String?
  name                  String
  role                  UserRole               @default(RESIDENT)
  accountStatus         AccountStatus          @default(PENDING)
  emailVerified         DateTime?
  plotNumber            String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  familyMembers         FamilyMember[]
  ledgerEntries         LedgerEntry[]
  approvedResetRequests PasswordResetRequest[] @relation("ApprovedBy")
  passwordResetRequests PasswordResetRequest[]
  requestComments       RequestComment[]       @relation("CommentAuthor")
  residentRequests      ResidentRequest[]
  sessions              Session[]
  notifications         Notification[]

  villa                Villa?
  maintenanceBills     MaintenanceBill[]
  payments             Payment[]              @relation("PaymentResident")
  paymentsRecorded     Payment[]              @relation("PaymentRecorder")
  specialLevies        SpecialLevy[]
  adjustments          Adjustment[]           @relation("AdjustmentResident")
  adjustmentsCreated   Adjustment[]           @relation("AdjustmentCreator")
  chatConversations    ChatConversation[]

  paymentRequestsSubmitted PaymentRequest[] @relation("PaymentRequestSubmitter")
  paymentRequestsReviewed  PaymentRequest[] @relation("PaymentRequestReviewer")


  @@index([email])
  @@index([plotNumber])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model PasswordResetRequest {
  id          String      @id @default(cuid())
  userId      String
  status      ResetStatus @default(PENDING)
  requestedAt DateTime    @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  expiresAt   DateTime
  token       String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  approver    User?       @relation("ApprovedBy", fields: [approvedBy], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([token])
}

model ResidentRequest {
  id                   String           @id @default(cuid())
  userId               String
  plotNumber           String
  requestType          RequestType
  status               RequestStatus    @default(PENDING)
  description          String
  adminNotes           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  newPlotSize          Int?
  familyMemberName     String?
  familyMemberRelation String?
  familyMemberContact  String?
  resolvedAt           DateTime?
  resolvedBy           String?
  lastResidentReplyAt  DateTime?
  reopenedAt           DateTime?
  reopenCount          Int              @default(0)
  comments             RequestComment[]
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([lastResidentReplyAt])
}

model RequestComment {
  id             String          @id @default(cuid())
  requestId      String
  authorId       String
  content        String
  isAdminComment Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  author         User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  request        ResidentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
  @@index([createdAt])
}

model FamilyMember {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String
  contact      String
  addedAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  userId      String?
  date        DateTime
  description String
  amount      Float
  type        TransactionType
  category    LedgerCategory
  balance     Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User?           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([category])
}

model SocietySettings {
  id                    String   @id @default(cuid())
  perSqFtRate           Float
  sinkingFundPercentage Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  totalVillas           Int      @default(47)
}

model Villa {
  id         String   @id @default(cuid())
  villaNo    Int      @unique
  type       String
  areaInSqM  Float
  ownerName  String
  areaInSqFt Float
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isBillable      Boolean  @default(true)

  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  maintenanceBills MaintenanceBill[]
  payments         Payment[]
  paymentRequests PaymentRequest[]

  @@index([villaNo])
  @@index([ownerName])
  @@index([userId])
}

model AppConfig {
  id          Int      @id @default(autoincrement())
  configKey   String   @unique @map("config_key")
  configValue Json     @map("config_value")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([configKey])
  @@map("app_config")
}

model MonthlyExpense {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  category    String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, year, category])
  @@index([month, year])
  @@index([category])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  content     String
  category    String
  priority    String
  isActive    Boolean            @default(true)
  publishDate DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  files       AnnouncementFile[]

  @@index([publishDate])
  @@index([category])
  @@index([priority])
  @@index([isActive])
}

model AnnouncementFile {
  id             String       @id @default(cuid())
  announcementId String
  url            String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

enum UserRole {
  RESIDENT
  ADMIN
}

enum ResetStatus {
  PENDING
  APPROVED
  COMPLETED
  EXPIRED
  DENIED
}

enum RequestType {
  PLOT_SIZE_UPDATE
  PAYMENT_ISSUE
  EXPENSE_SHEET_MONTHLY
  EXPENSE_SHEET_YEARLY
  ADD_FAMILY_MEMBER
  PASSWORD_RESET
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
  REOPENED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum LedgerCategory {
  CORE_OPERATIONS
  SINKING_FUND
}


// Monthly maintenance bill — one per villa per month
model MaintenanceBill {
  id          String     @id @default(cuid())
  userId      String?
  villaId     String
  month       Int        // 1-12
  year        Int

  // Snapshots — preserve historical accuracy if rates change
  areaInSqFt  Float
  ratePerSqFt Float
  amount      Float

  dueDate     DateTime
  status      BillStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  villa       Villa      @relation(fields: [villaId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id])
  allocations PaymentAllocation[]

  @@unique([villaId, month, year])
  @@index([villaId, status])
  @@index([month, year])
  @@index([villaId])
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
}

// Payment received from a resident
model Payment {
  id          String        @id @default(cuid())
  villaId     String?
  userId      String?        // resident who paid
  amount      Float
  method      PaymentMethod
  reference   String?       // UPI ref, cheque no, etc.
  notes       String?
  paidAt      DateTime      @default(now())
  recordedBy  String        // admin user id who recorded it
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  villa       Villa?        @relation(fields: [villaId], references: [id])
  user        User?         @relation("PaymentResident", fields: [userId], references: [id])
  recorder    User          @relation("PaymentRecorder", fields: [recordedBy], references: [id])
  allocations PaymentAllocation[]
  paymentRequest PaymentRequest? @relation("PaymentRequestPayment")

  @@index([userId, paidAt])
}

enum PaymentMethod {
  UPI
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

// Links payments to bills/levies — one payment can cover multiple items
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  billId    String?
  levyId    String?
  amount    Float
  createdAt DateTime @default(now())

  payment Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    MaintenanceBill? @relation(fields: [billId], references: [id], onDelete: Cascade)
  levy    SpecialLevy?     @relation(fields: [levyId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
  @@index([levyId])
}

// One-time special charges (e.g., emergency repair split across residents)
model SpecialLevy {
  id          String     @id @default(cuid())
  userId      String
  title       String     // "Emergency plumbing repair"
  reason      String?
  amount      Float
  status      BillStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  allocations PaymentAllocation[]

  @@index([userId, status])
}

// Manual corrections, late fees, waivers, write-offs
model Adjustment {
  id          String         @id @default(cuid())
  userId      String
  amount      Float          // positive = increases what they owe
  type        AdjustmentType
  reason      String
  createdById String
  createdAt   DateTime       @default(now())

  user      User @relation("AdjustmentResident", fields: [userId], references: [id])
  createdBy User @relation("AdjustmentCreator", fields: [createdById], references: [id])

  @@index([userId])
}

enum AdjustmentType {
  LATE_FEE
  WAIVER
  CORRECTION
  WRITE_OFF
  DISCOUNT
  CREDIT_NOTE
}

// Payment Requests

model PaymentRequest {
  id          String              @id @default(cuid())
  villaId     String
  userId      String              // resident who submitted the request

  // Payment details
  amount      Float
  method      PaymentMethod
  reference   String?             // UPI ref, txn ID, cheque no, etc.
  notes       String?             // optional resident notes
  receiptUrl  String?             // Vercel Blob URL — added in Step 30e

  // Workflow
  status      PaymentRequestStatus @default(PENDING)
  submittedAt DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?             // admin user id who reviewed
  reviewNotes String?             // admin's notes (esp. for rejection reason)

  // Link to actual Payment record (set when approved)
  paymentId   String?             @unique
  payment     Payment?            @relation("PaymentRequestPayment", fields: [paymentId], references: [id])

  // Relations
  villa       Villa               @relation(fields: [villaId], references: [id])
  user        User                @relation("PaymentRequestSubmitter", fields: [userId], references: [id])
  reviewer    User?               @relation("PaymentRequestReviewer", fields: [reviewedBy], references: [id])

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, submittedAt])
  @@index([villaId, status])
  @@index([userId, status])
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  category    String   // SYSTEM, BILLING, PAYMENT, HELPDESK, WATER, ANNOUNCEMENT
  title       String
  body        String?  // optional details
  link        String?  // optional internal URL to navigate to on tap
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isPinned  Boolean  @default(false)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, isPinned, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'assistant' | 'tool'
  content        String   // text content or JSON-serialized tool result
  toolName       String?  // populated when role='tool'
  createdAt      DateTime @default(now())
  isPinned       Boolean  @default(false)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ChatModel {
  id          String   @id              // e.g. "gpt-oss:120b"
  label       String                    // "GPT-OSS 120B"
  description String?
  status      String   @default("UNKNOWN") // FREE | PAID | UNKNOWN | ERROR
  lastTested  DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}
