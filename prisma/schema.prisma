// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication and authorization
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?   // Nullable to support password reset flow
  name          String
  role          UserRole  @default(RESIDENT)
  emailVerified DateTime?
  plotNumber    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions              Session[]
  passwordResetRequests PasswordResetRequest[]
  approvedResetRequests PasswordResetRequest[] @relation("ApprovedBy")
  residentRequests      ResidentRequest[]
  requestComments       RequestComment[]       @relation("CommentAuthor")
  familyMembers         FamilyMember[]
  ledgerEntries         LedgerEntry[]

  @@index([email])
  @@index([plotNumber])
}

enum UserRole {
  RESIDENT
  ADMIN
}

// Session model for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

// Password reset request model
model PasswordResetRequest {
  id          String      @id @default(cuid())
  userId      String
  status      ResetStatus @default(PENDING)
  requestedAt DateTime    @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  expiresAt   DateTime
  token       String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([token])
}

enum ResetStatus {
  PENDING
  APPROVED
  COMPLETED
  EXPIRED
  DENIED
}

// Resident request model with auto-resolution support
model ResidentRequest {
  id          String        @id @default(cuid())
  userId      String
  plotNumber  String
  requestType RequestType
  status      RequestStatus @default(PENDING)
  description String
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  resolvedAt  DateTime?     // When the request was resolved
  resolvedBy  String?       // User ID who resolved it (admin or resident)
  lastResidentReplyAt DateTime? // Track last resident reply for auto-resolution
  reopenedAt  DateTime?     // Track if request was reopened
  reopenCount Int          @default(0) // Track number of times reopened

  // Type-specific fields
  newPlotSize          Int?
  familyMemberName     String?
  familyMemberRelation String?
  familyMemberContact  String?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments RequestComment[]

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([lastResidentReplyAt])
}

// Request comment model for admin-resident communication
model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  content   String
  isAdminComment Boolean @default(false) // Track if comment is from admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request ResidentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
  @@index([createdAt])
}

enum RequestType {
  PLOT_SIZE_UPDATE
  PAYMENT_ISSUE
  EXPENSE_SHEET_MONTHLY
  EXPENSE_SHEET_YEARLY
  ADD_FAMILY_MEMBER
  PASSWORD_RESET
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
  REOPENED
}

// Family member model
model FamilyMember {
  id           String   @id @default(cuid())
  userId       String
  name         String
  relationship String
  contact      String
  addedAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Ledger entry model for financial tracking
model LedgerEntry {
  id          String         @id @default(cuid())
  userId      String?
  date        DateTime
  description String
  amount      Float
  type        TransactionType
  category    LedgerCategory
  balance     Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([category])
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum LedgerCategory {
  CORE_OPERATIONS
  SINKING_FUND
}

// Society settings model
model SocietySettings {
  id                    String   @id @default(cuid())
  perSqFtRate           Float
  sinkingFundPercentage Float
  totalVillas           Int      @default(47)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Villa model for plot/villa data management
model Villa {
  id              String   @id @default(cuid())
  villaNo         Int      @unique
  type            String
  areaInSqM       Float
  ownerName       String
  areaInSqFt      Float
  remarks         String?  // Optional field for additional notes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([villaNo])
  @@index([ownerName])
}

// App Configuration model for storing application settings
model AppConfig {
  id           Int      @id @default(autoincrement())
  configKey    String   @unique @map("config_key")
  configValue  Json     @map("config_value")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_config")
  @@index([configKey])
}

// Monthly Expense model for tracking community expenses
model MonthlyExpense {
  id          String   @id @default(cuid())
  month       Int      // 1-12
  year        Int
  category    String   // e.g., "Security", "Electricity", "Cleaning"
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, year, category])
  @@index([month, year])
  @@index([category])
}

// Announcement model for storing community announcements
model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // e.g., "General", "Maintenance", "Event"
  priority    String   // "low", "medium", "high", "critical"
  isActive    Boolean  @default(true)
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  files AnnouncementFile[]

  @@index([publishDate])
  @@index([category])
  @@index([priority])
  @@index([isActive])
}

// File attachment for community announcements
model AnnouncementFile {
  id             String       @id @default(cuid())
  announcementId String
  url            String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

