{
  "name": "my-enterprise-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "dotenv -e .env tsx prisma/seed.ts",
    "db:push": "prisma db push --url=$DATABASE_URL --accept-data-loss",
    "db:sync": "tsx scripts/sync-schema.ts",
    "db:recover": "dotenv -e .env tsx scripts/recover-database.ts",
    "seed:settings": "dotenv -e .env tsx scripts/seed-society-settings.ts",
    "seed:request-types": "dotenv -e .env tsx scripts/seed-request-types.ts",
    "migrate:villas": "dotenv -e .env tsx scripts/migrate-villas.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.0",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jsoneditor": "^10.4.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "^9.3.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsoneditor": "^9.9.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "uuid": "^14.0.0"
  }
